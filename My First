<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Agri Management System 🌾</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f7f6;
            color: #333;
        }

        /* Navigation */
        nav {
            background: #2e7d32;
            padding: 18px 50px;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: white;
            font-size: 24px;
            font-weight: bold;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 25px;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            font-size: 16px;
        }

        nav ul li a:hover {
            text-decoration: underline;
        }

        /* Hero Section */
        .hero {
            min-height: 420px;

            display: flex;
            align-items: center;
            justify-content: center;

            text-align: center;

            background: linear-gradient(
                rgba(46, 125, 50, 0.9),
                rgba(27, 94, 32, 0.9)
            );

            color: white;
            padding: 50px 20px;
        }

        .hero h1 {
            font-size: 48px;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 20px;
            margin-bottom: 30px;
        }

        .hero-btn {
            display: inline-block;

            background: white;
            color: #2e7d32;

            padding: 13px 25px;

            border-radius: 6px;

            text-decoration: none;

            font-weight: bold;
        }

        .hero-btn:hover {
            background: #e8f5e9;
        }

        /* Services */
        .services {
            padding: 60px 30px;
        }

        .services h2 {
            text-align: center;
            color: #2e7d32;
            margin-bottom: 40px;
            font-size: 32px;
        }

        .cards {
            max-width: 1100px;
            margin: auto;

            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 25px;
        }

        .card {
            background: white;

            padding: 30px;

            text-align: center;

            border-radius: 12px;

            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);

            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        }

        .card .icon {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .card h3 {
            color: #2e7d32;
            margin-bottom: 10px;
        }

        .card p {
            color: #666;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .card a {
            display: inline-block;

            background: #2e7d32;
            color: white;

            padding: 9px 18px;

            border-radius: 5px;

            text-decoration: none;
        }

        .card a:hover {
            background: #1b5e20;
        }

        /* Footer */
        footer {
            background: #1b5e20;

            color: white;

            text-align: center;

            padding: 20px;

            margin-top: 30px;
        }

        /* Mobile */
        @media (max-width: 800px) {

            nav {
                padding: 15px 20px;

                flex-direction: column;

                gap: 15px;
            }

            nav ul {
                gap: 15px;
            }

            .hero h1 {
                font-size: 35px;
            }

            .hero p {
                font-size: 17px;
            }

            .cards {
                grid-template-columns: 1fr;
            }
        }
    </style>

</head>

<body>

    <!-- Navigation -->

    <nav>

        <div class="logo">
            🌱 Agri Management
        </div>

        <ul>

            <li>
                <a href="{{ url('/') }}">
                    Home
                </a>
            </li>

            <li>
                <a href="{{ route('farmers.index') }}">
                    Farmers
                </a>
            </li>

            <li>
                <a href="{{ url('/crops') }}">
                    Crops
                </a>
            </li>

            <li>
                <a href="{{ url('/seed-distributions') }}">
                    Seeds
                </a>
            </li>

        </ul>

    </nav>


    <!-- Hero Section -->

    <section class="hero">

        <div>

            <h1>
               <i> Welcome to Agri Management System 🌾</i>
            </h1>

            <p>
                Manage farmers, crops and agricultural activities
                easily in one system.
            </p>

            <a href="{{ route('farmers.index') }}" class="hero-btn">
                Manage Farmers
            </a>

        </div>

    </section>


    <!-- Management Modules -->

    <section class="services">

        <h2>
            Management Modules
        </h2>

        <div class="cards">


            <!-- Farmer Management -->

            <div class="card">

                <div class="icon">
                    👨‍🌾
                </div>

                <h3>
                    Farmer Management
                </h3>

                <p>
                    Register and manage farmer information
                    including name, NIC, phone, address and district.
                </p>

                <a href="{{ route('farmers.index') }}">
                    Open
                </a>

            </div>


            <!-- Crop Management -->

            <div class="card">

                <div class="icon">
                    🌱
                </div>

                <h3>
                    Crop Management
                </h3>

                <p>
                    Manage crops and cultivation information
                    such as crop type, season and land area.
                </p>

                <a href="{{ url('/crops') }}">
                    Open
                </a>

            </div>


            <!-- Seed Management -->

            <div class="card">

                <div class="icon">
                    🌾
                </div>

                <h3>
                    Seed Management
                </h3>

                <p>
                    Manage seed distribution and farmer
                    seed records.
                </p>

                <a href="{{ url('/seed-distributions') }}">
                    Open
                </a>

            </div>


            <!-- Fertilizer Management -->

            <div class="card">

                <div class="icon">
                    🧪
                </div>

                <h3>
                    Fertilizer Management
                </h3>

                <p>
                    Manage fertilizer distribution and
                    fertilizer records.
                </p>

                <a href="#">
                    Open
                </a>

            </div>


            <!-- Farmer Assistance -->

            <div class="card">

                <div class="icon">
                    📋
                </div>

                <h3>
                    Farmer Assistance
                </h3>

                <p>
                    Manage farmer assistance requests
                    and support information.
                </p>

                <a href="#">
                    Open
                </a>

            </div>


            <!-- Reports -->

            <div class="card">

                <div class="icon">
                    📊
                </div>

                <h3>
                    Reports
                </h3>

                <p>
                    View useful agricultural management
                    reports and statistics.
                </p>

                <a href="#">
                    Open
                </a>

            </div>

        </div>

    </section>


    <!-- Footer -->

    <footer>

        <p>
           @ 2026 Agri Management System | All Rights Reserved
        </p>

    </footer>

</body>

</html>
